# FSTS AI Hub — Environment Variable Reference
#
# This file documents environment variable NAMES and their purpose only.
# It must NEVER contain working credentials or secret values.
#
# Copy to `.env` for local development and populate with your own
# non-production values. `.env` is gitignored.
#
# Secret values are owned by the API Hub and referenced by the AI Hub via
# credential references — never stored here. See docs/security/SECRET-MANAGEMENT.md.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
SERVICE_NAME=fsts-ai-hub

# ---------------------------------------------------------------------------
# Identity / authentication (references only — no secret values)
# ---------------------------------------------------------------------------
# OIDC issuer URL for service-to-service identity
AUTH_ISSUER_URL=
# Audience expected on inbound tokens
AUTH_AUDIENCE=
# JWKS endpoint for token verification
AUTH_JWKS_URI=

# ---------------------------------------------------------------------------
# API Hub connector (external connectivity is owned by the API Hub)
# ---------------------------------------------------------------------------
# Base URL of the API Hub control plane
API_HUB_BASE_URL=
# Credential reference name (NOT the credential value)
API_HUB_CREDENTIAL_REF=

# ---------------------------------------------------------------------------
# Compliance Hub connector (policy supply is owned by the Compliance Hub)
# ---------------------------------------------------------------------------
COMPLIANCE_HUB_BASE_URL=
COMPLIANCE_HUB_CREDENTIAL_REF=

# ---------------------------------------------------------------------------
# Model gateway (provider keys are owned by the API Hub, referenced here)
# ---------------------------------------------------------------------------
# Comma-separated list of approved provider identifiers
MODEL_GATEWAY_APPROVED_PROVIDERS=
# Credential reference for the default provider (NOT the value)
MODEL_GATEWAY_DEFAULT_CREDENTIAL_REF=

# ---------------------------------------------------------------------------
# Telemetry
# ---------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=fsts-ai-hub

# ---------------------------------------------------------------------------
# Command center (control plane)
# ---------------------------------------------------------------------------
COMMAND_CENTER_BASE_URL=
