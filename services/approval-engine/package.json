{
  "name": "@fsts/approval-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Approval Engine \u2014 manages human approval requests, state transitions, integrity binding, and expiry.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"lint: approval-engine (no-op)\"",
    "test": "vitest run",
    "test:security": "vitest run",
    "test:isolation": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@fsts/contracts": "workspace:*",
    "@fsts/security": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^4.1.11",
    "@fsts/testing": "workspace:*"
  }
}
