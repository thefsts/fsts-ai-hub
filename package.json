{
  "name": "@fsts/ai-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Headless AI governance, orchestration, and cost optimization backend for FSTS systems.",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc --noEmit",
