{
  "name": "fsts-ai-hub",
  "version": "0.1.0",
  "private": true,
  "description": "FSTS AI Hub — centralized AI governance, orchestration, security, routing, audit, memory, cost-control, and lifecycle platform for approved AI operating throughout FSTS systems.",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Full Stack Tech & Solutions LLC",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "typecheck": "turbo run typecheck && pnpm typecheck:convex",
    "typecheck:convex": "tsc -p tsconfig.json --noEmit",
    "test": "turbo run test && vitest run --config vitest.config.convex.mts",
    "test:convex": "vitest run --config vitest.config.convex.mts",
    "test:contract": "turbo run test:contract",
    "test:security": "turbo run test:security",
    "test:isolation": "turbo run test:isolation",
    "clean": "turbo run clean && rm -rf node_modules",
    "audit:deps": "pnpm audit --audit-level=high",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "convex:codegen": "convex codegen",
    "convex:dev": "convex dev",
    "convex:push": "convex dev --once",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm scan:secrets"
  },
  "dependencies": {
    "convex": "^1.31.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "convex-test": "^0.0.59",
    "prettier": "^3.3.3",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.18": ">=8.5.18",
      "vite@<6.4.3": ">=6.4.3"
    }
  }
}
