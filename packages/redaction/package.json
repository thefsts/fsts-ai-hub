{
  "name": "@fsts/redaction",
  "version": "0.1.0",
  "private": true,
  "description": "Sensitive-data redaction and filtering for FSTS AI Hub logs and payloads.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
