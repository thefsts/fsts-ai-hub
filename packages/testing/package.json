{
  "name": "@fsts/testing",
  "version": "0.1.0",
  "private": true,
  "description": "Shared test fixtures, builders, and assertions for the FSTS AI Hub. Provides deterministic, tenant-scoped fixtures used across contract, isolation, and security tests.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"lint: testing (no-op)\"",
    "test": "echo \"testing: no tests (fixtures only)\"",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@fsts/contracts": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
